# ==============================================================================
# AEV Module 1 — Pod Alpha: Platform Environment Configuration
# ==============================================================================

APP_ENV=development
PORT=8000

# PostgreSQL 17 Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pod_alpha_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pod_alpha_db

# Redis 8 Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# HashiCorp Vault 1.20
VAULT_ADDR=http://127.0.0.1:8200
VAULT_API_ADDR=http://vault:8200
VAULT_DEV_ROOT_TOKEN_ID=root

# Apache Kafka 7.7
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ZOOKEEPER_CLIENT_PORT=2181

# JWT & Zero-Trust Authentication
JWT_SECRET_KEY=cyart_pod_alpha_super_secret_jwt_key_32bytes_min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
SERVICE_API_KEY=dev_internal_key_pod_alpha_123
